# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=nexly
POSTGRES_PASSWORD=nexly_dev_password
POSTGRES_DB=nexly
POSTGRES_PORT=5432

# ── Redis ──────────────────────────────────────────────────
REDIS_PORT=6379

# ── API (NestJS) ───────────────────────────────────────────
API_PORT=3001
DATABASE_URL=postgresql://nexly:nexly_dev_password@localhost:5432/nexly?schema=public
REDIS_URL=redis://localhost:6379

# JWT RS256 (gerar com: openssl genpkey -algorithm RSA ... )
# Em desenvolvimento, use chaves de teste. Em produção, gere chaves reais.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGIN=http://localhost:3000

# ── Web (Next.js) ───────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
