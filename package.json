{
  "name": "nexly",
  "version": "0.1.0",
  "private": true,
  "description": "Nexly — plataforma SaaS de gestão para pequenos negócios (agenda + estoque/PDV)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "db:migrate": "npm run migrate --workspace @nexly/api",
    "db:studio": "npm run studio --workspace @nexly/api",
    "db:seed": "npm run seed --workspace @nexly/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "husky": "^9.1.6",
    "lint-staged": "17.6.0",
    "prettier": "^3.3.3",
    "turbo": "2.11.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {},
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "overrides": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3"
  }
}
