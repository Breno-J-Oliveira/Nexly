DATABASE_URL=postgresql://nexly:nexly_dev_password@localhost:5432/nexly?schema=public
REDIS_URL=redis://localhost:6379
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# ID público OAuth Web. Vazio desativa o acesso Google; segredo não é necessário no fluxo GIS.
GOOGLE_CLIENT_ID=312221207149-3jj903oajmlpooq2ltp68lbhlahttm06.apps.googleusercontent.com
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Origens permitidas (separadas por vírgula). Dev: http://localhost:3000.
# Prod: a URL do frontend (ex.: https://nexly.vercel.app).
CORS_ORIGIN=http://localhost:3000

# Cookie do refresh token. Vazio em dev e no split Vercel (front) + Railway (API).
# Defina apenas quando front e API compartilham o mesmo domínio raiz
# (ex.: app.nexly.com.br + api.nexly.com.br → COOKIE_DOMAIN=.nexly.com.br).
# sameSite='none' + secure=true são aplicados automaticamente em produção.
COOKIE_DOMAIN=

PORT=3001


# --- NexusAuth Bridge ---
NEXUSAUTH_URL=
NEXUSAUTH_API_KEY=
# --- WhatsApp Integration ---
# disabled | evolution | test | twilio | meta
WHATSAPP_PROVIDER=disabled
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-chave-aqui
EVOLUTION_INSTANCE=nexly

# Recuperação de senha: permanece desligada até configurar todos os campos.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_APP_URL=
# Chave de 32 bytes em hexadecimal (64 caracteres) para cifrar a fila.
EMAIL_QUEUE_KEY=

# Assinaturas do Nexly — somente Sandbox; cobrança real não é suportada nesta etapa.
# Segredos apenas no ambiente do backend, nunca em NEXT_PUBLIC_* ou no Git.
STRIPE_ENABLED=false
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_ORIGIN=http://localhost:3002
