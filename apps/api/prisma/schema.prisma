generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Migrations
// Baseline inicial: prisma/migrations/20260920000000_baseline/.
//   - dev:  npm run db:migrate:dev  (ou `npm run migrate`) cria nova migration
//   - prod: npm run db:migrate      (ou `npm run migrate:deploy`) aplica migrations
//   - RLS:  apps/api/prisma/seed-rls.sql aplicado à parte (não entra nas migrations)
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  GESTOR
  PROFISSIONAL
  RECEPCIONISTA
  CAIXA
}

enum Plano {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  CONCLUIDO
  CANCELADO
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

enum TipoCupom {
  PERCENTUAL
  FIXO
}

enum StatusPedido {
  RASCUNHO
  ENVIADO
  RECEBIDO
  CANCELADO
}

enum AuditAcao {
  CRIAR
  EDITAR
  EXCLUIR
  LOGIN
  LOGOUT
}

// ─────────────────────────────────────────────────────────────
// Núcleo (multi-tenant)
// ─────────────────────────────────────────────────────────────

model Empresa {
  assinatura Assinatura?
  id        String   @id @default(uuid())
  nome      String
  cnpj      String   @unique
  plano     Plano    @default(FREE)
  bookingToken String? @unique @map("booking_token")
  fusoHorario String @default("America/Sao_Paulo") @map("fuso_horario")
  horarioAbertura   String? @default("08:00") @map("horario_abertura")
  horarioFechamento String? @default("20:00") @map("horario_fechamento")
  diasFuncionamento String? @default("1,2,3,4,5,6") @map("dias_funcionamento")
  telefone       String?
  emailContato   String? @map("email_contato")
  endereco       String?
  descricao      String?
  instagram      String?
  whatsapp       String?
  segmento       String?
  preset         String?
  modulos        String[] @default(["agenda", "clientes", "profissionais", "servicos", "estoque", "pdv", "vendas", "relatorios", "comissao", "fidelidade"])
  cidade         String?
  dadosPagamento Json?   @map("dados_pagamento")
  horarios       Json?   @map("horarios")
  notificacoes   Json?   @map("notificacoes")
  lembretesAtivos Boolean  @default(false) @map("lembretes_ativos")
  templateLembrete String? @map("template_lembrete")
  preferencias Json @default("{}")
  primeiroAcessoDispensado Boolean @default(false) @map("primeiro_acesso_dispensado")
  lancamentos LancamentoFinanceiro[]
  jobs JobDuravel[]
  importacoes Importacao[]
  comprovacoes ComprovacaoOperacional[]
  transferencias TransferenciaFilial[]
  createdAt DateTime @default(now()) @map("created_at")

  tarefas Tarefa[]
  filiais Filial[]
  documentos Documento[]
  campanhas Campanha[]
  consentimentosMarketing ConsentimentoMarketing[]
  automacoes Automacao[]
  recorrencias Recorrencia[]
  usuarios Usuario[]
  cupons   Cupom[]
  fornecedores Fornecedor[]
  pedidosCompra PedidoCompra[]
  convites ConviteUsuario[]
  auditLogs AuditLog[]
  exclusoesConta ExclusaoConta[]

  @@map("empresas")
}

// Cobrança do próprio Nexly. O Sandbox não altera o plano comercial da empresa.
model Assinatura {
  empresaId String @id @map("empresa_id")
  customerId String? @unique @map("customer_id")
  subscriptionId String? @unique @map("subscription_id")
  plano Plano @default(FREE)
  status String @default("none")
  periodoFim DateTime? @map("periodo_fim")
  cancelarEm DateTime? @map("cancelar_em")
  checkoutId String? @unique @map("checkout_id")
  checkoutPlano Plano? @map("checkout_plano")
  checkoutChave String? @map("checkout_chave")
  updatedAt DateTime @updatedAt @map("updated_at")
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("assinaturas")
}

// Apenas recibos de processamento, sem payloads ou dados de cartão.
model EventoStripe {
  id String @id
  tipo String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("eventos_stripe")
}

model Usuario {
  recuperacoes RecuperacaoSenha[]
  id         String   @id @default(uuid())
  empresaId  String   @map("empresa_id")
  nome       String
  email      String   @unique
  senhaHash  String   @map("senha_hash")
  googleSubject String? @unique @map("google_subject")
  role       Role     @default(CAIXA)
  ativo      Boolean  @default(true)
  twoFactorSecret       String?  @map("two_factor_secret")
  twoFactorEnabled      Boolean  @default(false) @map("two_factor_enabled")
  twoFactorBackupCodes  String[] @map("two_factor_backup_codes")
  twoFactorChallengeHash String? @map("two_factor_challenge_hash")
  twoFactorChallengeExpiresAt DateTime? @map("two_factor_challenge_expires_at")
  twoFactorLastUsedStep Int? @map("two_factor_last_used_step")
  diasDeUso             Int @default(0) @map("dias_de_uso")
  ultimoDiaUso          String? @map("ultimo_dia_uso")
  lembrarAvaliacaoEm    DateTime? @map("lembrar_avaliacao_em")
  naoPedirAvaliacao     Boolean @default(false) @map("nao_pedir_avaliacao")
  createdAt  DateTime @default(now()) @map("created_at")

  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  sessoes AuthSession[]
  auditLogs     AuditLog[]
  termosAceite  TermoAceite[]
  depoimento    Depoimento?

  @@index([empresaId])
  @@map("usuarios")
}

model Depoimento {
  id String @id @default(uuid())
  empresaId String @map("empresa_id")
  usuarioId String @unique @map("usuario_id")
  nota Int
  texto String
  nomePublico String @map("nome_publico")
  ocupacao String
  autorizaPublicacao Boolean @default(false) @map("autoriza_publicacao")
  status String @default("PENDENTE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@index([empresaId])
  @@index([status, autorizaPublicacao, createdAt])
  @@map("depoimentos")
}

// Sessão estável entre rotações; revogação independente do token de renovação.
model AuthSession {
  id String @id @default(uuid())
  usuarioId String @map("usuario_id")
  revogado Boolean @default(false)
  lastRotationTokenId String? @map("last_rotation_token_id")
  lastRotationAt DateTime? @map("last_rotation_at")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  @@index([usuarioId, revogado])
  @@map("sessoes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  sessionId String    @map("session_id")
  usuarioId String    @map("usuario_id")
  tokenHash String    @map("token_hash") @unique
  expiresAt DateTime  @map("expires_at")
  revogado  Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")

  sessao AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([sessionId, revogado])
  @@map("refresh_tokens")
}


// ─────────────────────────────────────────────────────────────
// Módulo Agenda
// ─────────────────────────────────────────────────────────────

model Cliente {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  nome      String
  telefone  String?
  email     String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  agendamentos Agendamento[]
  pontosFidelidade Int @default(0) @map("pontos_fidelidade")
  totalGasto        Decimal? @default(0) @db.Decimal(10,2) @map("total_gasto")
  ultimaVisita      DateTime? @map("ultima_visita")
  tag               String?
  observacoes       String?
  vendas       Venda[]

  @@index([empresaId])
  @@index([empresaId, nome])
  @@index([empresaId, createdAt])
  @@map("clientes")
}

model Profissional {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  nome          String
  especialidade String?
  comissaoPercentual Float @default(0) @map("comissao_percentual")
  fotoUrl   String? @map("foto_url")
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  agendamentos Agendamento[]

  @@index([empresaId])
  @@map("profissionais")
}

model Servico {
  id         String   @id @default(uuid())
  empresaId  String   @map("empresa_id")
  nome       String
  duracaoMin Int      @map("duracao_min")
  preco      Decimal  @db.Decimal(10, 2)
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  agendamentos Agendamento[]
  insumos      InsumoServico[]

  @@index([empresaId])
  @@map("servicos")
}

model InsumoServico {
  id         String @id @default(uuid())
  servicoId  String @map("servico_id")
  produtoId  String @map("produto_id")
  quantidade Int

  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([servicoId, produtoId])
  @@index([servicoId])
  @@map("insumos_servico")
}

model Agendamento {
  id             String            @id @default(uuid())
  empresaId      String            @map("empresa_id")
  clienteId      String            @map("cliente_id")
  profissionalId String            @map("profissional_id")
  servicoId      String            @map("servico_id")
  dataHora       DateTime          @map("data_hora")
  dataHoraFim    DateTime          @map("data_hora_fim")
  status         StatusAgendamento @default(AGENDADO)
  pendenciasEstoque Json @default("[]") @map("pendencias_estoque")
  createdAt      DateTime          @default(now()) @map("created_at")

  cliente      Cliente      @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  servico      Servico      @relation(fields: [servicoId], references: [id], onDelete: Restrict)
  recorrenciaId String? @map("recorrencia_id")
  recorrencia Recorrencia? @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)
  vendas       Venda[]
  avaliacoes   Avaliacao[]

  @@index([empresaId, dataHora])
  @@index([empresaId, status, dataHora])
  @@index([empresaId, profissionalId, dataHora])
  @@index([profissionalId, status])
  @@map("agendamentos")
}

// ─────────────────────────────────────────────────────────────
// Módulo Estoque / PDV
// ─────────────────────────────────────────────────────────────

model Produto {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  nome          String
  sku           String
  preco         Decimal  @db.Decimal(10, 2)
  custoAtual    Decimal? @db.Decimal(10, 2) @map("custo_atual")
  estoqueAtual  Int      @default(0) @map("estoque_atual")
  estoqueMinimo Int      @default(5) @map("estoque_minimo")
  categoria     String?
  ativo         Boolean  @default(true)
  dataVencimento DateTime? @map("data_vencimento")
  lote          String?
  createdAt     DateTime @default(now()) @map("created_at")

  movimentacoes MovimentacaoEstoque[]
  itensVenda    ItemVenda[]
  insumos       InsumoServico[]
  itensPedidoCompra ItemPedidoCompra[]
  saldosFilial SaldoFilial[]

  @@unique([empresaId, sku])
  @@index([empresaId, categoria])
  @@map("produtos")
}

model MovimentacaoEstoque {
  id            String           @id @default(uuid())
  empresaId     String           @map("empresa_id")
  filialId      String?          @map("filial_id")
  produtoId     String           @map("produto_id")
  tipo          TipoMovimentacao
  quantidade    Int
  motivo        String
  agendamentoId String?          @map("agendamento_id")
  createdAt     DateTime         @default(now()) @map("created_at")

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([empresaId, produtoId, createdAt])
  @@index([empresaId, createdAt])
  @@map("movimentacoes_estoque")
}

model Venda {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  clienteId     String?  @map("cliente_id")
  agendamentoId String?  @map("agendamento_id")
  cupomId       String?  @map("cupom_id")
  filialId      String?  @map("filial_id")
  status        String   @default("CONCLUIDA")
  estornadaEm   DateTime? @map("estornada_em")
  motivoEstorno String? @map("motivo_estorno")
  chaveOperacao String? @map("chave_operacao")
  requisicaoHash String? @map("requisicao_hash")
  estornadaPor  String? @map("estornada_por")
  total         Decimal  @db.Decimal(10, 2)
  formaPagamento String? @default("DINHEIRO") @map("forma_pagamento")
  desconto       Decimal? @default(0) @db.Decimal(10, 2)
  valorPago      Decimal? @db.Decimal(10, 2) @map("valor_pago")
  troco          Decimal? @default(0) @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  cliente     Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  agendamento Agendamento? @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)
  cupom       Cupom?       @relation(fields: [cupomId], references: [id], onDelete: SetNull)
  itens       ItemVenda[]
  filial      Filial? @relation(fields: [filialId], references: [id], onDelete: Restrict)
  lancamento  LancamentoFinanceiro?

  @@index([empresaId, createdAt])
  @@index([empresaId, clienteId])
  @@unique([empresaId, chaveOperacao])
  @@map("vendas")
}

model ItemVenda {
  id            String @id @default(uuid())
  vendaId       String @map("venda_id")
  produtoId     String @map("produto_id")
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2) @map("preco_unitario")
  custoUnitario Decimal? @db.Decimal(10, 2) @map("custo_unitario")

  venda   Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([vendaId])
  @@map("itens_venda")
}


model Avaliacao {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  agendamentoId String   @unique @map("agendamento_id")
  nota          Int      // 0-10 NPS
  comentario    String?
  createdAt     DateTime @default(now()) @map("created_at")
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  @@index([empresaId])
  @@map("avaliacoes")
}

model Notificacao {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  usuarioId String   @map("usuario_id")
  titulo    String
  mensagem  String
  lida      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now()) @map("created_at")
  @@index([empresaId, usuarioId, lida])
  @@map("notificacoes")
}

model Cupom {
  id        String    @id @default(cuid())
  empresaId String    @map("empresa_id")
  codigo    String
  tipo      TipoCupom
  valor     Decimal   @db.Decimal(10, 2)
  usoMaximo Int?      @map("uso_maximo")
  usoAtual  Int       @default(0) @map("uso_atual")
  validade  DateTime?
  ativo     Boolean   @default(true)
  criadoEm  DateTime  @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  vendas  Venda[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@map("cupons")
}

model Fornecedor {
  id        String  @id @default(cuid())
  empresaId String  @map("empresa_id")
  nome      String
  cnpj      String?
  telefone  String?
  email     String?
  ativo     Boolean @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pedidos PedidoCompra[]

  @@index([empresaId])
  @@map("fornecedores")
}

model PedidoCompra {
  id           String       @id @default(cuid())
  empresaId    String       @map("empresa_id")
  fornecedorId String?      @map("fornecedor_id")
  status       StatusPedido @default(RASCUNHO)
  observacoes  String?
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")

  empresa    Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  fornecedor Fornecedor?         @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  itens      ItemPedidoCompra[]

  @@index([empresaId, status])
  @@map("pedidos_compra")
}

model ItemPedidoCompra {
  id            String   @id @default(cuid())
  pedidoId      String   @map("pedido_id")
  produtoId     String   @map("produto_id")
  quantidade    Int
  precoEsperado Decimal? @db.Decimal(10, 2) @map("preco_esperado")

  pedido  PedidoCompra @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto      @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([pedidoId])
  @@map("itens_pedido_compra")
}

model ConviteUsuario {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  email     String
  role      Role
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  usado     Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("convites_usuario")
}

model AuditLog {
  id           String    @id @default(cuid())
  empresaId    String    @map("empresa_id")
  usuarioId    String?   @map("usuario_id")
  acao         AuditAcao
  recurso      String
  recursoId    String?   @map("recurso_id")
  dadosAntigos Json?     @map("dados_antigos")
  dadosNovos   Json?     @map("dados_novos")
  ip           String?
  userAgent    String?   @map("user_agent")
  criadoEm     DateTime  @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([empresaId, criadoEm])
  @@index([empresaId, acao])
  @@map("audit_logs")
}

model TermoAceite {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  versao    String
  ip        String?
  aceitoEm  DateTime @default(now()) @map("aceito_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("termos_aceite")
}

model ExclusaoConta {
  id           String   @id @default(cuid())
  empresaId    String   @map("empresa_id")
  solicitadaEm DateTime @default(now()) @map("solicitada_em")
  executarEm   DateTime @map("executar_em")
  executada    Boolean  @default(false)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("exclusoes_conta")
}

model Filial {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  nome      String
  endereco  String
  telefone  String?
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tarefas   Tarefa[]
  saldos SaldoFilial[]
  vendas Venda[]
  lancamentos LancamentoFinanceiro[]

  @@index([empresaId, nome])
  @@map("filiais")
}

model Tarefa {
  id            String     @id @default(uuid())
  empresaId     String     @map("empresa_id")
  titulo        String
  descricao     String     @default("")
  status        String     @default("PENDENTE")
  prioridade    String     @default("NORMAL")
  prazo         DateTime?
  responsavelId String?    @map("responsavel_id")
  filialId      String?    @map("filial_id")
  automacaoId   String?    @map("automacao_id")
  ocorrencia    DateTime?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  empresa       Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  filial        Filial?    @relation(fields: [filialId], references: [id], onDelete: SetNull)
  automacao     Automacao? @relation(fields: [automacaoId], references: [id], onDelete: SetNull)

  @@unique([automacaoId, ocorrencia])
  @@index([empresaId, status, prazo])
  @@map("tarefas")
}

model Documento {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  titulo    String
  conteudo  String
  categoria String   @default("GERAL")
  versao    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, updatedAt])
  @@map("documentos")
}

model Campanha {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  titulo    String
  mensagem  String
  status    String   @default("RASCUNHO")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, createdAt])
  @@map("campanhas")
}

model ConsentimentoMarketing {
  id         String   @id @default(uuid())
  empresaId  String   @map("empresa_id")
  clienteId  String   @map("cliente_id")
  autorizado Boolean
  evidencia  String
  updatedAt  DateTime @updatedAt @map("updated_at")
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, clienteId])
  @@map("consentimentos_marketing")
}

model Automacao {
  id              String    @id @default(uuid())
  empresaId       String    @map("empresa_id")
  titulo          String
  descricao       String    @default("")
  intervaloDias   Int       @map("intervalo_dias")
  proximaExecucao DateTime  @map("proxima_execucao")
  ultimaExecucao  DateTime? @map("ultima_execucao")
  responsavelId   String?   @map("responsavel_id")
  ativa           Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  empresa         Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tarefas         Tarefa[]

  @@index([ativa, proximaExecucao])
  @@index([empresaId])
  @@map("automacoes")
}

model Recorrencia {
  id            String        @id @default(uuid())
  empresaId     String        @map("empresa_id")
  titulo        String
  intervaloDias Int           @map("intervalo_dias")
  quantidade    Int
  inicio        DateTime
  cancelada     Boolean       @default(false)
  createdAt     DateTime      @default(now()) @map("created_at")
  empresa       Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  agendamentos  Agendamento[]

  @@index([empresaId, inicio])
  @@map("recorrencias")
}
model LancamentoFinanceiro {
  id String @id @default(uuid())
  empresaId String @map("empresa_id")
  filialId String? @map("filial_id")
  vendaId String? @unique @map("venda_id")
  descricao String
  tipo String
  categoria String @default("GERAL")
  valor Decimal @db.Decimal(12,2)
  valorPago Decimal @default(0) @db.Decimal(12,2) @map("valor_pago")
  status String @default("ABERTO")
  vencimento DateTime
  createdAt DateTime @default(now()) @map("created_at")
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  filial Filial? @relation(fields: [filialId], references: [id], onDelete: Restrict)
  venda Venda? @relation(fields: [vendaId], references: [id], onDelete: Restrict)
  baixas BaixaFinanceira[]
  @@index([empresaId, vencimento, status])
  @@index([empresaId, filialId, vencimento])
  @@map("lancamentos_financeiros")
}

model BaixaFinanceira {
  id String @id @default(uuid())
  lancamentoId String @map("lancamento_id")
  chave String @unique
  valor Decimal @db.Decimal(12,2)
  data DateTime @default(now())
  estornada Boolean @default(false)
  estornadaEm DateTime? @map("estornada_em")
  lancamento LancamentoFinanceiro @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  @@index([lancamentoId, data])
  @@index([estornadaEm])
  @@map("baixas_financeiras")
}

model SaldoFilial {
  id String @id @default(uuid())
  empresaId String @map("empresa_id")
  filialId String @map("filial_id")
  produtoId String @map("produto_id")
  quantidade Int @default(0)
  filial Filial @relation(fields: [filialId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  @@unique([empresaId, filialId, produtoId])
  @@index([empresaId, produtoId])
  @@map("saldos_filiais")
}

model JobDuravel {
  id String @id @default(uuid())
  empresaId String @map("empresa_id")
  chave String @unique
  tipo String
  payload Json
  status String @default("PENDENTE")
  tentativas Int @default(0)
  executarEm DateTime @default(now()) @map("executar_em")
  reservadoEm DateTime? @map("reservado_em")
  reserva String?
  erro String?
  createdAt DateTime @default(now()) @map("created_at")
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  @@index([status, executarEm])
  @@index([empresaId, createdAt])
  @@map("jobs_duraveis")
}

model Importacao {
  id String @id @default(uuid())
  empresaId String @map("empresa_id")
  chave String
  tipo String
  resumo Json
  createdAt DateTime @default(now()) @map("created_at")
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  @@unique([empresaId, chave])
  @@map("importacoes")
}

model ComprovacaoOperacional {
  id String @id @default(uuid())
  empresaId String @map("empresa_id")
  tipo String
  referencia String
  verificadoEm DateTime @map("verificado_em")
  observacoes String
  usuarioId String @map("usuario_id")
  createdAt DateTime @default(now()) @map("created_at")
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  @@index([empresaId, tipo, verificadoEm])
  @@map("comprovacoes_operacionais")
}

model RecuperacaoSenha {
  id String @id @default(uuid())
  usuarioId String @map("usuario_id")
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usadoEm DateTime? @map("usado_em")
  createdAt DateTime @default(now()) @map("created_at")
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@index([usuarioId, expiresAt])
  @@map("recuperacoes_senha")
}

model TransferenciaFilial {
  id String @id @default(uuid())
  empresaId String @map("empresa_id")
  chave String
  produtoId String @map("produto_id")
  origemId String? @map("origem_id")
  destinoId String? @map("destino_id")
  quantidade Int
  motivo String
  createdAt DateTime @default(now()) @map("created_at")
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  @@unique([empresaId, chave])
  @@index([empresaId, createdAt])
  @@map("transferencias_filiais")
}
