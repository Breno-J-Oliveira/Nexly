generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Migrations
// Baseline inicial: prisma/migrations/20260920000000_baseline/.
//   - dev:  npm run db:migrate:dev  (ou `npm run migrate`) cria nova migration
//   - prod: npm run db:migrate      (ou `npm run migrate:deploy`) aplica migrations
//   - RLS:  apps/api/prisma/seed-rls.sql aplicado à parte (não entra nas migrations)
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  GESTOR
  PROFISSIONAL
  RECEPCIONISTA
  CAIXA
}

enum Plano {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  CONCLUIDO
  CANCELADO
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

enum TipoCupom {
  PERCENTUAL
  FIXO
}

enum StatusPedido {
  RASCUNHO
  ENVIADO
  RECEBIDO
  CANCELADO
}

enum AuditAcao {
  CRIAR
  EDITAR
  EXCLUIR
  LOGIN
  LOGOUT
}

// ─────────────────────────────────────────────────────────────
// Núcleo (multi-tenant)
// ─────────────────────────────────────────────────────────────

model Empresa {
  id        String   @id @default(uuid())
  nome      String
  cnpj      String   @unique
  plano     Plano    @default(FREE)
  bookingToken String? @unique @map("booking_token")
  horarioAbertura   String? @default("08:00") @map("horario_abertura")
  horarioFechamento String? @default("20:00") @map("horario_fechamento")
  diasFuncionamento String? @default("1,2,3,4,5,6") @map("dias_funcionamento")
  telefone       String?
  emailContato   String? @map("email_contato")
  endereco       String?
  descricao      String?
  instagram      String?
  whatsapp       String?
  segmento       String?
  cidade         String?
  dadosPagamento Json?   @map("dados_pagamento")
  horarios       Json?   @map("horarios")
  notificacoes   Json?   @map("notificacoes")
  lembretesAtivos Boolean  @default(false) @map("lembretes_ativos")
  templateLembrete String? @map("template_lembrete")
  createdAt DateTime @default(now()) @map("created_at")

  usuarios Usuario[]
  cupons   Cupom[]
  fornecedores Fornecedor[]
  pedidosCompra PedidoCompra[]
  convites ConviteUsuario[]
  auditLogs AuditLog[]
  exclusoesConta ExclusaoConta[]

  @@map("empresas")
}

model Usuario {
  id         String   @id @default(uuid())
  empresaId  String   @map("empresa_id")
  nome       String
  email      String   @unique
  senhaHash  String   @map("senha_hash")
  role       Role     @default(CAIXA)
  ativo      Boolean  @default(true)
  twoFactorSecret       String?  @map("two_factor_secret")
  twoFactorEnabled      Boolean  @default(false) @map("two_factor_enabled")
  twoFactorBackupCodes  String[] @map("two_factor_backup_codes")
  createdAt  DateTime @default(now()) @map("created_at")

  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  termosAceite  TermoAceite[]

  @@index([empresaId])
  @@map("usuarios")
}

model RefreshToken {
  id        String    @id @default(uuid())
  usuarioId String    @map("usuario_id")
  tokenHash String    @map("token_hash") @unique
  expiresAt DateTime  @map("expires_at")
  revogado  Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}


// ─────────────────────────────────────────────────────────────
// Módulo Agenda
// ─────────────────────────────────────────────────────────────

model Cliente {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  nome      String
  telefone  String?
  email     String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  agendamentos Agendamento[]
  pontosFidelidade Int @default(0) @map("pontos_fidelidade")
  totalGasto        Decimal? @default(0) @db.Decimal(10,2) @map("total_gasto")
  ultimaVisita      DateTime? @map("ultima_visita")
  tag               String?
  observacoes       String?
  vendas       Venda[]

  @@index([empresaId])
  @@map("clientes")
}

model Profissional {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  nome          String
  especialidade String?
  comissaoPercentual Float @default(0) @map("comissao_percentual")
  fotoUrl   String? @map("foto_url")
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  agendamentos Agendamento[]

  @@index([empresaId])
  @@map("profissionais")
}

model Servico {
  id         String   @id @default(uuid())
  empresaId  String   @map("empresa_id")
  nome       String
  duracaoMin Int      @map("duracao_min")
  preco      Decimal  @db.Decimal(10, 2)
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  agendamentos Agendamento[]
  insumos      InsumoServico[]

  @@index([empresaId])
  @@map("servicos")
}

model InsumoServico {
  id         String @id @default(uuid())
  servicoId  String @map("servico_id")
  produtoId  String @map("produto_id")
  quantidade Int

  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([servicoId, produtoId])
  @@index([servicoId])
  @@map("insumos_servico")
}

model Agendamento {
  id             String            @id @default(uuid())
  empresaId      String            @map("empresa_id")
  clienteId      String            @map("cliente_id")
  profissionalId String            @map("profissional_id")
  servicoId      String            @map("servico_id")
  dataHora       DateTime          @map("data_hora")
  dataHoraFim    DateTime          @map("data_hora_fim")
  status         StatusAgendamento @default(AGENDADO)
  createdAt      DateTime          @default(now()) @map("created_at")

  cliente      Cliente      @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  servico      Servico      @relation(fields: [servicoId], references: [id], onDelete: Restrict)
  vendas       Venda[]
  avaliacoes   Avaliacao[]

  @@index([empresaId, dataHora])
  @@index([profissionalId, status])
  @@map("agendamentos")
}

// ─────────────────────────────────────────────────────────────
// Módulo Estoque / PDV
// ─────────────────────────────────────────────────────────────

model Produto {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  nome          String
  sku           String
  preco         Decimal  @db.Decimal(10, 2)
  estoqueAtual  Int      @default(0) @map("estoque_atual")
  estoqueMinimo Int      @default(5) @map("estoque_minimo")
  categoria     String?
  ativo         Boolean  @default(true)
  dataVencimento DateTime? @map("data_vencimento")
  lote          String?
  createdAt     DateTime @default(now()) @map("created_at")

  movimentacoes MovimentacaoEstoque[]
  itensVenda    ItemVenda[]
  insumos       InsumoServico[]
  itensPedidoCompra ItemPedidoCompra[]

  @@unique([empresaId, sku])
  @@index([empresaId, categoria])
  @@map("produtos")
}

model MovimentacaoEstoque {
  id            String           @id @default(uuid())
  empresaId     String           @map("empresa_id")
  produtoId     String           @map("produto_id")
  tipo          TipoMovimentacao
  quantidade    Int
  motivo        String
  agendamentoId String?          @map("agendamento_id")
  createdAt     DateTime         @default(now()) @map("created_at")

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([empresaId, produtoId, createdAt])
  @@map("movimentacoes_estoque")
}

model Venda {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  clienteId     String?  @map("cliente_id")
  agendamentoId String?  @map("agendamento_id")
  cupomId       String?  @map("cupom_id")
  total         Decimal  @db.Decimal(10, 2)
  formaPagamento String? @default("DINHEIRO") @map("forma_pagamento")
  desconto       Decimal? @default(0) @db.Decimal(10, 2)
  valorPago      Decimal? @db.Decimal(10, 2) @map("valor_pago")
  troco          Decimal? @default(0) @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  cliente     Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  agendamento Agendamento? @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)
  cupom       Cupom?       @relation(fields: [cupomId], references: [id], onDelete: SetNull)
  itens       ItemVenda[]

  @@index([empresaId, createdAt])
  @@map("vendas")
}

model ItemVenda {
  id            String @id @default(uuid())
  vendaId       String @map("venda_id")
  produtoId     String @map("produto_id")
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2) @map("preco_unitario")

  venda   Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([vendaId])
  @@map("itens_venda")
}


model Avaliacao {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  agendamentoId String   @unique @map("agendamento_id")
  nota          Int      // 0-10 NPS
  comentario    String?
  createdAt     DateTime @default(now()) @map("created_at")
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  @@index([empresaId])
  @@map("avaliacoes")
}

model Notificacao {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  usuarioId String   @map("usuario_id")
  titulo    String
  mensagem  String
  lida      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now()) @map("created_at")
  @@index([empresaId, usuarioId, lida])
  @@map("notificacoes")
}

model Cupom {
  id        String    @id @default(cuid())
  empresaId String    @map("empresa_id")
  codigo    String
  tipo      TipoCupom
  valor     Decimal   @db.Decimal(10, 2)
  usoMaximo Int?      @map("uso_maximo")
  usoAtual  Int       @default(0) @map("uso_atual")
  validade  DateTime?
  ativo     Boolean   @default(true)
  criadoEm  DateTime  @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  vendas  Venda[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@map("cupons")
}

model Fornecedor {
  id        String  @id @default(cuid())
  empresaId String  @map("empresa_id")
  nome      String
  cnpj      String?
  telefone  String?
  email     String?
  ativo     Boolean @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pedidos PedidoCompra[]

  @@index([empresaId])
  @@map("fornecedores")
}

model PedidoCompra {
  id           String       @id @default(cuid())
  empresaId    String       @map("empresa_id")
  fornecedorId String?      @map("fornecedor_id")
  status       StatusPedido @default(RASCUNHO)
  observacoes  String?
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")

  empresa    Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  fornecedor Fornecedor?         @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  itens      ItemPedidoCompra[]

  @@index([empresaId, status])
  @@map("pedidos_compra")
}

model ItemPedidoCompra {
  id            String   @id @default(cuid())
  pedidoId      String   @map("pedido_id")
  produtoId     String   @map("produto_id")
  quantidade    Int
  precoEsperado Decimal? @db.Decimal(10, 2) @map("preco_esperado")

  pedido  PedidoCompra @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto      @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([pedidoId])
  @@map("itens_pedido_compra")
}

model ConviteUsuario {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  email     String
  role      Role
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  usado     Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("convites_usuario")
}

model AuditLog {
  id           String    @id @default(cuid())
  empresaId    String    @map("empresa_id")
  usuarioId    String?   @map("usuario_id")
  acao         AuditAcao
  recurso      String
  recursoId    String?   @map("recurso_id")
  dadosAntigos Json?     @map("dados_antigos")
  dadosNovos   Json?     @map("dados_novos")
  ip           String?
  userAgent    String?   @map("user_agent")
  criadoEm     DateTime  @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([empresaId, criadoEm])
  @@index([empresaId, acao])
  @@map("audit_logs")
}

model TermoAceite {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  versao    String
  ip        String?
  aceitoEm  DateTime @default(now()) @map("aceito_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("termos_aceite")
}

model ExclusaoConta {
  id           String   @id @default(cuid())
  empresaId    String   @map("empresa_id")
  solicitadaEm DateTime @default(now()) @map("solicitada_em")
  executarEm   DateTime @map("executar_em")
  executada    Boolean  @default(false)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("exclusoes_conta")
}
