# Nexly API — variables de producción (sin valores reales)
# Copiar a .env con los valores reales, o configurar en Railway.

NODE_ENV=production
PORT=3001

# Banco (Supabase)
DATABASE_URL=postgresql://postgres.[ref]:[senha]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[senha]@aws-0-[region].pooler.supabase.com:5432/postgres

# Redis (Upstash)
REDIS_URL=rediss://:[senha]@[endpoint].upstash.io:6380

# JWT (RS256 — generar claves con openssl)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Auth
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS
CORS_ORIGIN=https://nexly.vercel.app

# WhatsApp (opcional)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=
WHATSAPP_API_KEY=