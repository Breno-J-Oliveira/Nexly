# ─────────────────────────────────────────────────────────────
# Nexly API — variáveis de PRODUÇÃO (sem valores reais)
# Copie para `.env` com os valores reais, ou configure no Railway.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001

# ── Banco de dados ──────────────────────────────────────────
# Supabase: DATABASE_URL usa o pooler (pgbouncer=true) e DIRECT_URL o direto.
DATABASE_URL=postgresql://postgres.[ref]:[senha]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[senha]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Cache ───────────────────────────────────────────────────
# Redis (Upstash) — formato ioredis: rediss://default:[senha]@[endpoint].upstash.io:6379
REDIS_URL=rediss://default:[senha]@[endpoint].upstash.io:6379

# ── JWT RS256 ───────────────────────────────────────────────
# jwt-keys.ts aceita PEM cru OU base64 do PEM. No Railway (env de uma linha),
# use base64 do conteúdo do arquivo .pem:  base64 -w0 private.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── CORS ────────────────────────────────────────────────────
# URL(s) do frontend, separadas por vírgula. Jamais use '*'.
CORS_ORIGIN=https://nexly.vercel.app

# ── Cookie de auth (refreshToken) ───────────────────────────
# No split Vercel (front) + Railway (API), deixe VAZIO.
# Só preencha quando front e API dividem o mesmo domínio raiz:
#   app.nexly.com.br (front) + api.nexly.com.br (API) → .nexly.com.br
# Obs.: sameSite='none' + secure=true são aplicados automaticamente em produção.
COOKIE_DOMAIN=

# ── Bridge NexusAuth (opcional) ─────────────────────────────
NEXUSAUTH_URL=
NEXUSAUTH_API_KEY=

# ── WhatsApp (opcional — disabled | evolution | test | twilio | meta) ──
WHATSAPP_PROVIDER=disabled
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=nexly