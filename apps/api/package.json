{
  "name": "@nexly/api",
  "version": "0.1.0",
  "private": true,
  "description": "Nexly API — NestJS + Prisma + PostgreSQL",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed:prod": "ts-node --require dotenv/config prisma/seed.ts",
    "studio": "prisma studio",
    "seed": "prisma db seed",
    "rls:apply": "psql \"$DATABASE_URL\" -f prisma/seed-rls.sql",
    "prestart:prod": "npm run migrate:deploy"
  },
  "prisma": {
    "seed": "ts-node --require dotenv/config prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nexly/shared": "*",
    "@otplib/preset-default": "^12.0.1",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.2",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "18.0.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/plugin-transform-dynamic-import": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@nexly/tsconfig": "*",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "^20.17.6",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "babel-jest": "30.5.2",
    "babel-plugin-transform-import-meta": "2.3.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "30.5.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "29.4.15",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "6.0.2"
  }
}
